{
  "name": "sto-vehicle-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "SAP-inspired foundation for STO & Vehicle Management System",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node server/src/index.js",
    "build": "vite build",
    "start": "node server/src/index.js",
    "preview": "vite preview",
    "check": "npm run build && node --check server/src/index.js",
    "build:pages": "npm run build && node scripts/prepare-github-pages.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.3"
  }
}
